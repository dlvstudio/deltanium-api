    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>deltanium_api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.11" />
